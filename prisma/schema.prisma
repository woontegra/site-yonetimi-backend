enum AssetStatus {
  ACTIVE
  IN_MAINTENANCE
  OUT_OF_SERVICE
  LOST
  SCRAPPED
  DISPOSED
}

enum AssetMovementType {
  CREATED
  LOCATION_CHANGED
  STATUS_CHANGED
  QUANTITY_CHANGED
  UPDATED
}

/// Demirbaş kategorisi (tenant seviyesi).
model AssetCategory {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assets Asset[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive, sortOrder])
  @@map("asset_categories")
}

/// Siteye ait demirbaş kaydı.
model Asset {
  id               String      @id @default(uuid())
  tenantId         String
  siteId           String
  buildingId       String?
  apartmentId      String?
  assetCategoryId  String?
  name             String
  code             String?
  quantity         Int         @default(1)
  unit             String?
  purchaseDate     DateTime?
  purchasePrice    Decimal?    @db.Decimal(12, 2)
  currentValue     Decimal?    @db.Decimal(12, 2)
  supplierName     String?
  location         String?
  brand            String?
  model            String?
  serialNumber     String?
  warrantyEndDate  DateTime?
  status           AssetStatus @default(ACTIVE)
  description      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  building  Building?      @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartment Apartment?     @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  category  AssetCategory? @relation(fields: [assetCategoryId], references: [id], onDelete: SetNull)
  movements    AssetMovement[]
  maintenances AssetMaintenance[]

  @@index([tenantId, siteId, deletedAt])
  @@index([siteId, status, deletedAt])
  @@index([buildingId, deletedAt])
  @@index([apartmentId])
  @@index([assetCategoryId])
  @@index([tenantId, name])
  @@map("assets")
}

/// Demirbaş bakım / onarım kaydı (soft delete).
model AssetMaintenance {
  id                  String    @id @default(uuid())
  tenantId            String
  siteId              String
  assetId             String
  /// Serbest metin; arayüz hazır seçenekler sunar.
  type                String
  maintenanceDate     DateTime
  description         String
  cost                Decimal?  @db.Decimal(12, 2)
  performedBy         String?
  nextMaintenanceDate DateTime?
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)
  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, maintenanceDate])
  @@index([tenantId, siteId, deletedAt])
  @@map("asset_maintenances")
}

/// Demirbaş hareket / geçmiş kaydı (silinmez).
model AssetMovement {
  id               String            @id @default(uuid())
  tenantId         String
  siteId           String
  assetId          String
  type             AssetMovementType
  fromBuildingId   String?
  toBuildingId     String?
  fromLocation     String?
  toLocation       String?
  previousStatus   AssetStatus?
  newStatus        AssetStatus?
  previousQuantity Int?
  newQuantity      Int?
  note             String?
  occurredAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  fromBuilding Building? @relation("AssetMovementFromBuilding", fields: [fromBuildingId], references: [id], onDelete: SetNull)
  toBuilding   Building? @relation("AssetMovementToBuilding", fields: [toBuildingId], references: [id], onDelete: SetNull)

  @@index([assetId, occurredAt])
  @@index([tenantId, siteId, occurredAt])
  @@map("asset_movements")
}

enum AnnouncementAudienceType {
  ALL_SITE
  BUILDINGS
  APARTMENTS
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELLED
}

/// Site duyurusu. İletişim kanalları (WhatsApp/SMS/e-posta) ayrı fazda eklenecek.
model Announcement {
  id              String                    @id @default(uuid())
  tenantId        String
  siteId          String
  title           String
  content         String
  audienceType    AnnouncementAudienceType
  priority        AnnouncementPriority      @default(NORMAL)
  status          AnnouncementStatus        @default(DRAFT)
  publishAt       DateTime?
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site            Site                     @relation(fields: [siteId], references: [id], onDelete: Restrict)
  createdByUser   User?                    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  buildings       AnnouncementBuilding[]
  apartments      AnnouncementApartment[]

  @@index([tenantId, siteId, deletedAt])
  @@index([siteId, status, deletedAt])
  @@index([tenantId, status, deletedAt])
  @@index([siteId, publishedAt])
  @@index([createdByUserId])
  @@map("announcements")
}

model AnnouncementBuilding {
  id             String   @id @default(uuid())
  tenantId       String
  announcementId String
  buildingId     String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  building     Building     @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@unique([announcementId, buildingId])
  @@index([tenantId, buildingId])
  @@index([announcementId])
  @@map("announcement_buildings")
}

model AnnouncementApartment {
  id             String   @id @default(uuid())
  tenantId       String
  announcementId String
  apartmentId    String
  createdAt      DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  apartment    Apartment    @relation(fields: [apartmentId], references: [id], onDelete: Restrict)

  @@unique([announcementId, apartmentId])
  @@index([tenantId, apartmentId])
  @@index([announcementId])
  @@map("announcement_apartments")
}

enum FeedbackType {
  INFO
  SUGGESTION
  REQUEST
  COMPLAINT
}

enum FeedbackPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum FeedbackStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/// Tenant seviyesinde bilgi/öneri/talep/şikâyet kategorisi.
model FeedbackCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  records FeedbackRecord[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive, sortOrder])
  @@map("feedback_categories")
}

/// Siteye ait bilgi / öneri / talep / şikâyet kaydı.
model FeedbackRecord {
  id           String           @id @default(uuid())
  tenantId     String
  siteId       String
  buildingId   String?
  apartmentId  String?
  personId     String?
  employeeId   String?
  categoryId   String?
  type         FeedbackType
  title        String
  description  String
  priority     FeedbackPriority @default(NORMAL)
  status       FeedbackStatus   @default(OPEN)
  resolution   String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  tenant    Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      Site                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  building  Building?               @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartment Apartment?              @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  person    Person?                 @relation(fields: [personId], references: [id], onDelete: SetNull)
  employee  Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  category  FeedbackCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  histories FeedbackStatusHistory[]

  @@index([tenantId, siteId, deletedAt])
  @@index([siteId, status, deletedAt])
  @@index([siteId, type, deletedAt])
  @@index([siteId, priority, deletedAt])
  @@index([categoryId])
  @@index([employeeId])
  @@index([personId])
  @@index([buildingId])
  @@index([apartmentId])
  @@map("feedback_records")
}

model FeedbackStatusHistory {
  id               String         @id @default(uuid())
  tenantId         String
  siteId           String
  feedbackRecordId String
  previousStatus   FeedbackStatus?
  newStatus        FeedbackStatus
  note             String?
  createdAt        DateTime       @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site           Site           @relation(fields: [siteId], references: [id], onDelete: Restrict)
  feedbackRecord FeedbackRecord @relation(fields: [feedbackRecordId], references: [id], onDelete: Cascade)

  @@index([feedbackRecordId, createdAt])
  @@index([tenantId, siteId, createdAt])
  @@map("feedback_status_histories")
}

enum MessageChannel {
  WHATSAPP
  SMS
}

enum CommunicationMessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
  CANCELLED
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  CONNECTED
  ERROR
}

enum WhatsAppTemplateStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PAUSED
  DISABLED
  UNKNOWN
}

enum WhatsAppTemplateSource {
  META_SYNC
  LIBRARY
  CUSTOM
}

/// Tenant seviyesinde WhatsApp Cloud API bağlantısı.
model WhatsAppIntegration {
  id                    String                   @id @default(uuid())
  tenantId              String
  wabaId                String
  phoneNumberId         String
  businessPhone         String?
  displayPhoneNumber    String?
  verifiedName          String?
  accessTokenEncrypted  String
  tokenLastFour         String?
  apiVersion            String
  isActive              Boolean                  @default(true)
  connectionStatus      WhatsAppConnectionStatus @default(DISCONNECTED)
  lastCheckedAt         DateTime?
  lastError             String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  deletedAt             DateTime?

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates WhatsAppTemplate[]

  @@index([tenantId, deletedAt, isActive])
  @@map("whatsapp_integrations")
}

/// Meta WhatsApp şablonu (tenant seviyesi, entegrasyon altında).
model WhatsAppTemplate {
  id                String                 @id @default(uuid())
  tenantId          String
  integrationId     String?
  metaTemplateId    String?
  name              String
  displayName       String?
  language          String
  category          String?
  status            WhatsAppTemplateStatus
  source            WhatsAppTemplateSource @default(META_SYNC)
  bodyText          String?
  parameterMapping  Json?
  libraryKey        String?
  componentsJson    Json
  lastSyncedAt      DateTime
  submittedAt       DateTime?
  rejectionReason   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  isStale           Boolean                @default(false)
  deletedAt         DateTime?

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration      WhatsAppIntegration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  messageTemplates MessageTemplate[]

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@map("whatsapp_templates")
}

/// Tenant seviyesinde mesaj şablonu. Site-scoped değildir.
model MessageTemplate {
  id                       String         @id @default(uuid())
  tenantId                 String
  name                     String
  channel                  MessageChannel
  body                     String
  whatsAppTemplateId       String?
  whatsAppParameterMapping Json?
  isActive                 Boolean        @default(true)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  deletedAt                DateTime?

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  whatsAppTemplate WhatsAppTemplate? @relation(fields: [whatsAppTemplateId], references: [id], onDelete: SetNull)

  @@index([tenantId, deletedAt])
  @@index([tenantId, channel, isActive])
  @@map("message_templates")
}

/// Toplu gönderim grubu. Site-scoped.
model CommunicationBatch {
  id          String         @id @default(uuid())
  tenantId    String
  siteId      String
  channel     MessageChannel
  totalCount  Int            @default(0)
  sentCount   Int            @default(0)
  failedCount Int            @default(0)
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site     Site                    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  messages CommunicationMessage[]
  idempotencyKeys CommunicationIdempotencyKey[]

  @@index([tenantId, siteId, createdAt])
  @@index([siteId, createdAt])
  @@map("communication_batches")
}

/// Tekil gönderim kaydı. Site-scoped.
model CommunicationMessage {
  id                String                      @id @default(uuid())
  tenantId          String
  siteId            String
  batchId           String?
  channel           MessageChannel
  personId          String?
  apartmentId       String?
  debtId            String?
  toPhone           String
  body              String
  status            CommunicationMessageStatus  @default(PENDING)
  provider          String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site      Site                 @relation(fields: [siteId], references: [id], onDelete: Restrict)
  batch     CommunicationBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  person    Person?              @relation(fields: [personId], references: [id], onDelete: SetNull)
  apartment Apartment?           @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  debt      ApartmentDebt?       @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@index([tenantId, siteId, createdAt])
  @@index([siteId, status, createdAt])
  @@index([batchId])
  @@index([personId])
  @@index([apartmentId])
  @@index([providerMessageId])
  @@map("communication_messages")
}

/// Aynı Idempotency-Key ile tekrarlayan toplu gönderimleri tekilleştirir.
model CommunicationIdempotencyKey {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  batchId   String
  createdAt DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch  CommunicationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("communication_idempotency_keys")
}

enum SubscriptionPlan {
  DEMO
  STANDARD
  PROFESSIONAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Tenant başına tek güncel abonelik. Ödeme sağlayıcısı bu fazda yok.
model Subscription {
  id           String             @id @default(uuid())
  tenantId     String             @unique
  plan         SubscriptionPlan   @default(DEMO)
  status       SubscriptionStatus @default(TRIAL)
  startsAt     DateTime
  endsAt       DateTime
  trialEndsAt  DateTime?
  cancelledAt  DateTime?
  note         String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, endsAt])
  @@map("subscriptions")
}

/// Platform admin işlem kaydı. Silinmez.
model AdminAuditLog {
  id          String   @id @default(uuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  tenantId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  adminUser User    @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  tenant    Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([tenantId, createdAt])
  @@index([adminUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

/// Yalnız platform admin'e görünen support notu.
model AdminNote {
  id          String    @id @default(uuid())
  tenantId    String
  adminUserId String
  content     String
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adminUser User   @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, deletedAt, createdAt])
  @@map("admin_notes")
}

enum SmtpSecurity {
  SSL_TLS
  STARTTLS
}

enum PlatformEmailStatus {
  UNCONFIGURED
  READY
  ERROR
  INACTIVE
}

enum EmailDeliveryType {
  TENANT_WELCOME_ACTIVATION
  PLATFORM_NEW_TENANT_NOTIFICATION
  SMTP_TEST
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

/// Merkezi platform SMTP bağlantısı. Tenant-scoped değildir; tek aktif kayıt beklenir.
model PlatformEmailIntegration {
  id                    String               @id @default(uuid())
  providerType          String               @default("SMTP")
  senderName            String
  senderEmail           String
  replyToEmail          String?
  smtpHost              String
  smtpPort              Int
  smtpSecurity          SmtpSecurity
  smtpUsername          String
  encryptedSmtpPassword String
  isActive              Boolean              @default(true)
  status                PlatformEmailStatus  @default(UNCONFIGURED)
  lastTestedAt          DateTime?
  lastSuccessfulAt      DateTime?
  lastErrorCode         String?
  lastErrorSummary      String?
  notificationEmail     String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  updatedByUserId       String?

  updatedByUser User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("platform_email_integrations")
}

/// İşlemsel e-posta teslimat kaydı. Gövde ve aktivasyon URL'si saklanmaz.
model EmailDelivery {
  id               String              @id @default(uuid())
  type             EmailDeliveryType
  recipientEmail   String
  recipientName    String?
  subject          String
  status           EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  attempts         Int                 @default(0)
  lastAttemptAt    DateTime?
  sentAt           DateTime?
  safeErrorCode    String?
  safeErrorSummary String?
  relatedTenantId  String?
  relatedUserId    String?
  metadata         Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  relatedTenant Tenant? @relation(fields: [relatedTenantId], references: [id], onDelete: SetNull)
  relatedUser   User?   @relation(fields: [relatedUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@index([relatedTenantId, createdAt])
  @@index([relatedUserId])
  @@map("email_deliveries")
}

/// Tek kullanımlık hesap aktivasyon tokenı. Açık token saklanmaz.
model UserActivationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("user_activation_tokens")
}


