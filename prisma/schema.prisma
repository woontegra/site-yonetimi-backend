generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Müşteri / yönetim hesabı. Tenant güvenlik sınırıdır; Site ile karıştırılmaz.
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships               Membership[]
  tenantAuditLogs           TenantAuditLog[]
  subscription              Subscription?
  adminNotes                AdminNote[]
  adminAuditLogs            AdminAuditLog[]
  buildings                 Building[]
  apartments                Apartment[]
  persons                   Person[]
  apartmentPersonRelations  ApartmentPersonRelation[]
  duesDefinitions           DuesDefinition[]
  apartmentDuesExemptions   ApartmentDuesExemption[]
  apartmentDebts            ApartmentDebt[]
  payments                  Payment[]
  paymentAllocations        PaymentAllocation[]
  paymentIdempotencyKeys    PaymentIdempotencyKey[]
  expenseTypes              ExpenseType[]
  expenses                  Expense[]
  bankAccounts              BankAccount[]
  bankTransactions          BankTransaction[]
  bankMatchingRules         BankMatchingRule[]
  bankColumnMappingTemplates BankColumnMappingTemplate[]
  suppliers                 Supplier[]
  employees                 Employee[]
  employeeAssignments       EmployeeAssignment[]
  visitors                  Visitor[]
  visits                    Visit[]
  sites                     Site[]
  assetCategories           AssetCategory[]
  assets                    Asset[]
  assetMovements            AssetMovement[]
  assetMaintenances         AssetMaintenance[]
  announcements             Announcement[]
  announcementBuildings     AnnouncementBuilding[]
  announcementApartments    AnnouncementApartment[]
  feedbackCategories        FeedbackCategory[]
  feedbackRecords           FeedbackRecord[]
  feedbackStatusHistories   FeedbackStatusHistory[]
  messageTemplates          MessageTemplate[]
  communicationBatches      CommunicationBatch[]
  communicationMessages     CommunicationMessage[]
  communicationIdempotencyKeys CommunicationIdempotencyKey[]
  whatsAppIntegrations      WhatsAppIntegration[]
  whatsAppTemplates         WhatsAppTemplate[]
  emailDeliveries           EmailDelivery[]

  @@map("tenants")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  isActive         Boolean  @default(true)
  /// Platform operatör yetkisi. Tenant UserRole ile karıştırılmaz.
  isPlatformAdmin  Boolean  @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  memberships    Membership[]
  tenantAuditLogs TenantAuditLog[]
  announcements  Announcement[]
  adminNotes     AdminNote[]
  adminAuditLogs AdminAuditLog[]
  activationTokens UserActivationToken[]
  emailDeliveries  EmailDelivery[]
  platformEmailUpdates PlatformEmailIntegration[]
  duesExemptionsCreated ApartmentDuesExemption[] @relation("ApartmentDuesExemptionCreatedBy")
  duesExemptionsRevoked ApartmentDuesExemption[] @relation("ApartmentDuesExemptionRevokedBy")

  @@map("users")
}

/// Kullanıcının bir site/tenant içindeki rolü.
enum UserRole {
  SITE_YONETICISI
  YONETIM_PERSONELI
  MUHASEBE_PERSONELI
  SINIRLI_YETKILI
  ORGANIZASYON_SAHIBI
  YONETICI
  MUHASEBE
  OPERASYON
  GORUNTULEYICI
}

enum MembershipStatus {
  INVITED
  ACTIVE
  DISABLED
}

model Membership {
  id                 String           @id @default(uuid())
  userId             String
  tenantId           String
  role               UserRole         @default(SITE_YONETICISI)
  status             MembershipStatus @default(ACTIVE)
  allSites           Boolean          @default(true)
  permissions        Json             @default("[]")
  permissionVersion  Int              @default(0)
  invitedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteAccesses MembershipSiteAccess[]

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@map("memberships")
}

model MembershipSiteAccess {
  id           String @id @default(uuid())
  membershipId String
  siteId       String

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  site       Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([membershipId, siteId])
  @@index([siteId])
  @@map("membership_site_accesses")
}

model TenantAuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("tenant_audit_logs")
}

enum SiteSetupStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

/// Yönetilen site / yerleşke. Tenant altında birden fazla olabilir.
model Site {
  id               String          @id @default(uuid())
  tenantId         String
  name             String
  code             String?
  address          String?
  city             String?
  district         String?
  description      String?
  isActive         Boolean         @default(true)
  setupStatus      SiteSetupStatus @default(NOT_STARTED)
  setupCompletedAt DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipSiteAccesses MembershipSiteAccess[]
  buildings           Building[]
  expenses            Expense[]
  bankAccounts        BankAccount[]
  bankMatchingRules   BankMatchingRule[]
  bankColumnMappingTemplates BankColumnMappingTemplate[]
  employeeAssignments EmployeeAssignment[]
  assets              Asset[]
  assetMovements      AssetMovement[]
  assetMaintenances   AssetMaintenance[]
  announcements       Announcement[]
  feedbackRecords     FeedbackRecord[]
  feedbackStatusHistories FeedbackStatusHistory[]
  communicationBatches    CommunicationBatch[]
  communicationMessages   CommunicationMessage[]
  apartmentDuesExemptions ApartmentDuesExemption[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("sites")
}

model Building {
  id             String    @id @default(uuid())
  tenantId       String
  siteId         String
  name           String
  code           String?
  address        String?
  city           String?
  district       String?
  apartmentCount Int?
  floorCount     Int?
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site                Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  apartments          Apartment[]
  duesDefinitions     DuesDefinition[]
  apartmentDebts      ApartmentDebt[]
  expenses            Expense[]
  bankMatchingRules   BankMatchingRule[]
  employeeAssignments EmployeeAssignment[]
  assets              Asset[]
  movementsFrom       AssetMovement[]     @relation("AssetMovementFromBuilding")
  movementsTo         AssetMovement[]     @relation("AssetMovementToBuilding")
  announcementBuildings AnnouncementBuilding[]
  feedbackRecords       FeedbackRecord[]

  @@index([tenantId, deletedAt])
  @@index([siteId, deletedAt])
  @@index([tenantId, name])
  @@map("buildings")
}

model Apartment {
  id            String    @id @default(uuid())
  tenantId      String
  buildingId    String
  number        String
  floor         String?
  roomType      String?
  squareMeters  Float?
  hasBalcony    Boolean?
  isActive      Boolean   @default(true)
  description   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building  Building                  @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  relations ApartmentPersonRelation[]
  debts     ApartmentDebt[]
  duesExemptions ApartmentDuesExemption[]
  payments  Payment[]
  matchedBankTransactions BankTransaction[] @relation("BankTxMatchedApartment")
  bankMatchingRules       BankMatchingRule[]
  visits                  Visit[]
  announcementApartments  AnnouncementApartment[]
  feedbackRecords         FeedbackRecord[]
  communicationMessages   CommunicationMessage[]
  assets                  Asset[]

  @@index([tenantId, deletedAt])
  @@index([buildingId, deletedAt])
  @@index([buildingId, number])
  @@map("apartments")
}

model Person {
  id         String    @id @default(uuid())
  tenantId   String
  firstName  String
  lastName   String
  phone      String?
  email      String?
  /// Hassas alan; ileride şifreleme eklenebilir. Loglara yazılmaz.
  nationalId String?
  gender     String?
  occupation String?
  birthDate  DateTime?
  note       String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  relations ApartmentPersonRelation[]
  payments  Payment[]
  matchedBankTransactions BankTransaction[] @relation("BankTxMatchedPerson")
  bankMatchingRules       BankMatchingRule[]
  hostedVisits            Visit[]
  feedbackRecords         FeedbackRecord[]
  communicationMessages   CommunicationMessage[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, lastName, firstName])
  @@map("persons")
}

enum ApartmentRelationType {
  OWNER
  TENANT
}

model ApartmentPersonRelation {
  id           String                @id @default(uuid())
  tenantId     String
  apartmentId  String
  personId     String
  relationType ApartmentRelationType
  startDate    DateTime?
  endDate      DateTime?
  isPrimary    Boolean               @default(false)
  isActive     Boolean               @default(true)
  note         String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apartment Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Restrict)

  @@index([tenantId, isActive])
  @@index([apartmentId, relationType, isActive])
  @@index([personId, isActive])
  @@map("apartment_person_relations")
}

enum ApartmentDuesExemptionType {
  FULL
  PERCENT
  FIXED
}

enum ApartmentDuesExemptionReason {
  MANAGER
  STAFF
  BOARD_DECISION
  OTHER
}

/// Daire bazlı aidat muafiyeti / indirimi. Geçmiş borçları değiştirmez.
model ApartmentDuesExemption {
  id              String                       @id @default(uuid())
  tenantId        String
  siteId          String
  apartmentId     String
  exemptionType   ApartmentDuesExemptionType
  /// PERCENT: 0–100; FIXED: TL tutarı. FULL için null.
  value           Decimal?                     @db.Decimal(12, 2)
  startDate       DateTime
  endDate         DateTime?
  reason          ApartmentDuesExemptionReason
  note            String?
  isActive        Boolean                      @default(true)
  createdByUserId String
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  revokedAt       DateTime?
  revokedByUserId String?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site          Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  apartment     Apartment @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  createdByUser User      @relation("ApartmentDuesExemptionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedByUser User?     @relation("ApartmentDuesExemptionRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, siteId, isActive])
  @@index([apartmentId, isActive, startDate, endDate])
  @@index([tenantId, apartmentId, isActive])
  @@map("apartment_dues_exemptions")
}

/// Dönemsel aidat tanımı. Gerçek finansal kayıt ApartmentDebt'tir.
model DuesDefinition {
  id                String    @id @default(uuid())
  tenantId          String
  buildingId        String
  name              String
  amount            Decimal   @db.Decimal(12, 2)
  periodYear        Int
  periodMonth       Int
  dueDate           DateTime
  description       String?
  isActive          Boolean   @default(true)
  /** Aynı toplu borçlandırma isteğinden oluşan tanımları gruplar. */
  assessmentBatchId String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building Building        @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  debts    ApartmentDebt[]

  @@index([tenantId, deletedAt])
  @@index([buildingId, periodYear, periodMonth])
  @@index([tenantId, assessmentBatchId])
  @@map("dues_definitions")
}

enum ApartmentDebtType {
  DUES
  MANUAL
}

enum ApartmentDebtStatus {
  OPEN
  PAID
  CANCELLED
}

/// Daireye yazılmış finansal borç kaydı.
model ApartmentDebt {
  id               String              @id @default(uuid())
  tenantId         String
  buildingId       String
  apartmentId      String
  duesDefinitionId String?
  type             ApartmentDebtType
  title            String
  originalAmount   Decimal             @db.Decimal(12, 2)
  remainingAmount  Decimal             @db.Decimal(12, 2)
  dueDate          DateTime
  periodYear       Int?
  periodMonth      Int?
  description      String?
  status           ApartmentDebtStatus @default(OPEN)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  cancelledAt      DateTime?

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  building       Building            @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  apartment      Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  duesDefinition DuesDefinition?     @relation(fields: [duesDefinitionId], references: [id], onDelete: SetNull)
  allocations    PaymentAllocation[]
  communicationMessages CommunicationMessage[]

  @@unique([duesDefinitionId, apartmentId])
  @@index([tenantId, status])
  @@index([apartmentId, status])
  @@index([buildingId, status])
  @@index([periodYear, periodMonth])
  @@map("apartment_debts")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum PaymentStatus {
  COMPLETED
  CANCELLED
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  apartmentId   String
  personId      String?
  amount        Decimal       @db.Decimal(12, 2)
  paymentDate   DateTime
  paymentMethod PaymentMethod
  referenceNo   String?
  description   String?
  status        PaymentStatus @default(COMPLETED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cancelledAt   DateTime?

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  apartment   Apartment           @relation(fields: [apartmentId], references: [id], onDelete: Restrict)
  person      Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  allocations PaymentAllocation[]
  bankTransaction BankTransaction?

  @@index([tenantId, status])
  @@index([apartmentId, status])
  @@index([tenantId, paymentDate])
  @@map("payments")
}

model PaymentAllocation {
  id              String   @id @default(uuid())
  tenantId        String
  paymentId       String
  apartmentDebtId String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  apartmentDebt ApartmentDebt @relation(fields: [apartmentDebtId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([paymentId])
  @@index([apartmentDebtId])
  @@map("payment_allocations")
}

/// Aynı Idempotency-Key ile tekrarlayan POST payment isteklerini tekilleştirir.
model PaymentIdempotencyKey {
  id        String   @id @default(uuid())
  tenantId  String
  key       String
  paymentId String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("payment_idempotency_keys")
}

enum ExpenseStatus {
  COMPLETED
  CANCELLED
}

model ExpenseType {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  isActive  Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive, sortOrder])
  @@map("expense_types")
}

/// Site yönetiminin yaptığı harcama kaydı. ApartmentDebt ile karıştırılmaz.
model Expense {
  id            String        @id @default(uuid())
  tenantId      String
  siteId        String
  buildingId    String?
  expenseTypeId String
  supplierId    String?
  title         String
  amount        Decimal       @db.Decimal(12, 2)
  expenseDate   DateTime
  paymentMethod PaymentMethod
  referenceNo   String?
  description   String?
  status        ExpenseStatus @default(COMPLETED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cancelledAt   DateTime?

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        Site        @relation(fields: [siteId], references: [id], onDelete: Restrict)
  building    Building?   @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  expenseType ExpenseType @relation(fields: [expenseTypeId], references: [id], onDelete: Restrict)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction?

  @@index([tenantId, status])
  @@index([tenantId, expenseDate])
  @@index([siteId, expenseDate])
  @@index([buildingId])
  @@index([expenseTypeId])
  @@index([supplierId])
  @@map("expenses")
}

model Supplier {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  taxNumber     String?
  taxOffice     String?
  city          String?
  district      String?
  address       String?
  note          String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("suppliers")
}

enum BankConnectionType {
  MANUAL
  API
}

enum BankTransactionDirection {
  CREDIT
  DEBIT
}

enum BankTransactionStatus {
  ACTIVE
  IGNORED
}

enum BankMatchStatus {
  UNMATCHED
  SUGGESTED
  MATCHED
  PROCESSED
}

/// Giden (DEBIT) hareket sınıflandırması. Gelen hareketlerde null.
enum BankDebitClass {
  UNCLASSIFIED
  EXPENSE
  EXCLUDED
}

model BankAccount {
  id                String             @id @default(uuid())
  tenantId          String
  siteId            String
  bankName          String
  accountName       String
  iban              String?
  accountNumber     String?
  branchName        String?
  currency          String             @default("TRY")
  openingBalance    Decimal            @db.Decimal(12, 2) @default(0)
  currentBalance    Decimal?           @db.Decimal(12, 2)
  isActive          Boolean            @default(true)
  connectionType    BankConnectionType @default(MANUAL)
  provider          String?
  externalAccountId String?
  lastSyncAt        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site         Site                @relation(fields: [siteId], references: [id], onDelete: Restrict)
  transactions BankTransaction[]
  matchingRules BankMatchingRule[]
  columnMappingTemplates BankColumnMappingTemplate[]

  @@index([tenantId, deletedAt])
  @@index([siteId, deletedAt])
  @@index([tenantId, isActive])
  @@map("bank_accounts")
}

model BankTransaction {
  id                    String                   @id @default(uuid())
  tenantId              String
  bankAccountId         String
  externalTransactionId String?
  /// Import mükerrer koruması. Manuel kayıtlarda null olabilir.
  importFingerprint     String?
  transactionDate       DateTime
  valueDate             DateTime?
  direction             BankTransactionDirection
  amount                Decimal                  @db.Decimal(12, 2)
  description           String
  senderName            String?
  senderIban            String?
  referenceNo           String?
  balanceAfter          Decimal?                 @db.Decimal(12, 2)
  status                BankTransactionStatus    @default(ACTIVE)
  matchStatus           BankMatchStatus          @default(UNMATCHED)
  /// DEBIT sınıflandırması. CREDIT için null.
  debitClass            BankDebitClass?
  matchedApartmentId    String?
  matchedPersonId       String?
  paymentId             String?                  @unique
  expenseId             String?                  @unique
  matchedAt             DateTime?
  processedAt           DateTime?
  ignoredAt             DateTime?
  importedAt            DateTime                 @default(now())
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bankAccount      BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedApartment Apartment?   @relation("BankTxMatchedApartment", fields: [matchedApartmentId], references: [id], onDelete: SetNull)
  matchedPerson    Person?      @relation("BankTxMatchedPerson", fields: [matchedPersonId], references: [id], onDelete: SetNull)
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense          Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, bankAccountId, importFingerprint])
  @@index([tenantId, matchStatus])
  @@index([bankAccountId, transactionDate])
  @@index([tenantId, status])
  @@index([tenantId, direction, debitClass])
  @@index([externalTransactionId])
  @@map("bank_transactions")
}

/// Banka ekstresi kolon eşleme şablonu (tenant/site izolasyonlu).
model BankColumnMappingTemplate {
  id            String    @id @default(uuid())
  tenantId      String
  siteId        String
  bankAccountId String?
  name          String
  /// { date, description, amount?, debit?, credit?, reference?, balance?, valueDate? }
  mapping       Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, siteId, deletedAt])
  @@index([bankAccountId, deletedAt])
  @@map("bank_column_mapping_templates")
}

model BankMatchingRule {
  id            String    @id @default(uuid())
  tenantId      String
  siteId        String
  bankAccountId String?
  name          String
  containsText  String
  buildingId    String?
  apartmentId   String?
  personId      String?
  isActive      Boolean   @default(true)
  priority      Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site        Site         @relation(fields: [siteId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  building    Building?    @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  apartment   Apartment?   @relation(fields: [apartmentId], references: [id], onDelete: SetNull)
  person      Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@index([tenantId, deletedAt, isActive])
  @@index([siteId, deletedAt, isActive])
  @@index([bankAccountId, isActive])
  @@index([tenantId, priority])
  @@map("bank_matching_rules")
}

/// Site personeli (kapıcı, güvenlik vb.). User hesabı ile aynı şey değildir.
model Employee {
  id               String    @id @default(uuid())
  tenantId         String
  firstName        String
  lastName         String
  phone            String?
  email            String?
  address          String?
  jobTitle         String
  hireDate         DateTime?
  terminationDate  DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments     EmployeeAssignment[]
  feedbackRecords FeedbackRecord[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, isActive])
  @@index([tenantId, lastName, firstName])
  @@map("employees")
}

model EmployeeAssignment {
  id         String    @id @default(uuid())
  tenantId   String
  siteId     String
  employeeId String
  buildingId String?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Restrict)
  employee Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  building Building? @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  @@index([tenantId, employeeId])
  @@index([siteId, isActive])
  @@index([employeeId, isActive])
  @@index([buildingId])
  @@map("employee_assignments")
}

enum VisitStatus {
  EXPECTED
  INSIDE
  COMPLETED
  CANCELLED
}

model Visitor {
  id         String    @id @default(uuid())
  tenantId   String
  firstName  String
  lastName   String
  phone      String?
  /// Hassas alan; liste yanıtında varsayılan dönülmez. Loglara yazılmaz.
  nationalId String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@index([tenantId, deletedAt])
  @@index([tenantId, lastName, firstName])
  @@map("visitors")
}

model Visit {
  id            String      @id @default(uuid())
  tenantId      String
  visitorId     String
  apartmentId   String
  hostPersonId  String?
  purpose       String?
  vehiclePlate  String?
  expectedAt    DateTime?
  checkInAt     DateTime
  checkOutAt    DateTime?
  status        VisitStatus @default(INSIDE)
  note          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
