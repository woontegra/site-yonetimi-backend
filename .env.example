PORT=4100
NODE_ENV=development
DATABASE_URL="postgresql://postgres@localhost:5433/site_yonetim?schema=public"
JWT_SECRET="change-this-to-a-long-random-secret"
# Access token süresi (varsayılan 15m). Saf sayı = saniye.
JWT_EXPIRES_IN="15m"
# Refresh token (opsiyonel ayrı secret; yoksa JWT_SECRET'tan türetilir)
# JWT_REFRESH_SECRET="change-this-to-another-long-random-secret"
JWT_REFRESH_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
# Canlıda (Railway): CORS_ORIGIN="https://site.woontegra.com"
# PUBLIC_APP_URL origin’i de otomatik eklenir; sonda slash olmasın.

# WhatsApp Cloud API (FAZ 18)
WHATSAPP_GRAPH_API_VERSION="v21.0"
WHATSAPP_PROVIDER_MODE=mock
WHATSAPP_HTTP_TIMEOUT_MS=15000
# 32-byte hex key for local dev only — generate your own for real use
WHATSAPP_CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="change-this-webhook-verify-token"
# META_APP_SECRET="your-meta-app-secret"
# Embedded Signup henüz yok. Tek tıkla bağlanma için ayrıca gerekir:
# META_APP_ID=
# META_EMBEDDED_SIGNUP_CONFIG_ID=
# META_OAUTH_REDIRECT_URI=
# Facebook JS SDK + whatsapp_business_management / whatsapp_business_messaging izinleri

# Comma-separated existing user emails granted platform admin on boot/login.
# Never grant via API. Example: PLATFORM_ADMIN_EMAILS="ops@woontegra.com"
# PLATFORM_ADMIN_EMAILS=

# Organizasyon lisansı: süresi dolunca tenant mutasyonları salt okunur (platform admin muaf).
# Eski LICENSE_ENFORCEMENT bayrağı artık kullanılmaz; salt okunur mod varsayılandır.
# LICENSE_ANNUAL_NET_PRICE=4000
# LICENSE_VAT_RATE=20
# LICENSE_SUPPORT_EMAIL=destek@woontegra.com
# LICENSE_RENEWAL_URL=

# Merkezi işlemsel e-posta (FAZ 25). Değerler: mock | smtp
# Geliştirmede varsayılan mock'tur; gerçek Gmail/SMTP için smtp yazın.
# MAIL_PROVIDER kullanılmaz.
EMAIL_PROVIDER_MODE=smtp
EMAIL_HTTP_TIMEOUT_MS=15000
# Aktivasyon bağlantıları. Canlıda: https://site.woontegra.com  (sonda slash olmasın)
PUBLIC_APP_URL="http://localhost:3001"
# CREDENTIAL_ENCRYPTION_KEY yoksa WhatsApp anahtarı kullanılır (AES-256-GCM).
# Railway'de değere tırnak veya sonda boşluk yapıştırmayın; dotenv tırnağı yerelde siler, Railway silmez.
# CREDENTIAL_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
